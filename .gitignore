# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Environment variables - never commit these
.env
frontend/.env
backend/.env

# Vite build output
frontend/dist/

# Logs
logs/
*.log
npm-debug.log*
nodemon-debug.log*

# OS files
.DS_Store
Thumbs.db

# VSCode (we commit .vscode/ intentionally for shared settings)
# but not personal workspace state
.vscode/*.log

# Coverage reports
coverage/

# Temporary files
*.tmp
*.temp